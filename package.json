{
  "name": "outpost",
  "private": true,
  "version": "1.0.1",
  "description": "Outpost - a self-hosted web panel for creating and managing Minecraft Java & Bedrock servers.",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev --workspace=server\" \"npm:dev --workspace=web\"",
    "build": "npm run build --workspace=server && npm run build --workspace=web",
    "start": "npm run start --workspace=server",
    "setup": "npm install",
    "test:release": "npm run build && node server/test/release-checks.mjs",
    "test:release:checks": "node server/test/release-checks.mjs",
    "test:fleet": "npm run build && node server/test/fleet-extensibility.mjs",
    "test:capabilities": "npm run build && node server/test/publish-game-capabilities.mjs --browser",
    "capabilities:publish": "npm run build && node server/test/publish-game-capabilities.mjs --browser --publish"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "allowScripts": {
    "node-pty": true
  }
}
